# Throwaway credentials for the local docker-compose Postgres container --
# not secrets. Production values are injected by the platform (Render/Neon
# env vars), never read from this file.
POSTGRES_USER=retail
POSTGRES_PASSWORD=localdev
POSTGRES_DB=retail_intelligence
DATABASE_URL=postgresql://retail:localdev@localhost:5432/retail_intelligence

# Real secrets -- leave empty here, set locally or in the platform's env vars.
NEON_DATABASE_URL=
LLM_PROVIDER=gemini
LLM_API_KEY=

